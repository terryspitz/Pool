{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Pool (webgl2)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3000/public/index.html",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "serve"
		},
		{
			"name": "Pool (2d canvas)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3000/public/index.html?mode=canvas",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "serve"
		}
	]
}
