{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "serve",
			"detail": "Static server over the repo root; open /public/index.html",
			"type": "shell",
			"command": "npx --yes serve . --listen 3000",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": {
				"pattern": {
					"regexp": "^(?!x)x$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Local:"
				}
			}
		},
		{
			"label": "bench",
			"detail": "Separable wave evaluation: accuracy and speed, in node",
			"type": "npm",
			"script": "bench",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "bench-web",
			"detail": "Both renderers, in headless Chromium",
			"type": "npm",
			"script": "bench-web",
			"group": "test",
			"problemMatcher": []
		}
	]
}
