<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The workflow installs .NET 8 and the runner image carries 8/9/10, so a
         netcoreapp3.1 test assembly cannot start a test host: vstest aborts with
         "framework_version=3.1.0 ... to install missing framework". -->
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit stays on 3.x: 4.0 moved Assert.AreEqual and friends to
         NUnit.Framework.Legacy.ClassicAssert, which PoolTest.fs uses throughout. -->
    <PackageReference Include="nunit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PoolTest.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../App.fsproj" />
  </ItemGroup>

</Project>
